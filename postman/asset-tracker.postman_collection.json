{
  "info": {
    "name": "Asset Tracker API",
    "description": "Main asset, employee and assignment workflow, including error examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "assetId",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "assignmentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health check returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create asset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_code\": \"AST-9001\",\n  \"name\": \"Demo Laptop\",\n  \"category\": \"Electronics\"\n}"
        },
        "url": "{{baseUrl}}/assets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Asset created with 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('assetId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_code\": \"EMP-9001\",\n  \"name\": \"Demo Employee\",\n  \"department\": \"IT\"\n}"
        },
        "url": "{{baseUrl}}/employees"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Employee created with 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('employeeId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign asset to employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_id\": {{assetId}},\n  \"employee_id\": {{employeeId}}\n}"
        },
        "url": "{{baseUrl}}/assignments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Assignment created with 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('assignmentId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List employee current assets",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/{{employeeId}}/assets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Current asset list returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate active assignment (expected 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_id\": {{assetId}},\n  \"employee_id\": {{employeeId}}\n}"
        },
        "url": "{{baseUrl}}/assignments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate active assignment is rejected with 409', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown asset (expected 404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/assets/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown asset returns 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
